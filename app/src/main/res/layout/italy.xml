        android:id="@+id/italy_verGuidelineChoiceCol1Left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/italy_verGuidelineChoiceCol1Left" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_verGuidelineChoiceCol1Right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/italy_verGuidelineChoiceCol1Right" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_verGuidelineChoiceCol2Left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/italy_verGuidelineChoiceCol2Left" />

    <androidx.constraintlayout.widget.Guideline
