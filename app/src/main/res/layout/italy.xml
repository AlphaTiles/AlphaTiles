    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_verGuidelineRefRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/italy_verGuidelineRefRight" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_verGuidelinePlayNextLeft"
