        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@dimen/italy_horGuidelinePlayNextTop" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_horGuidelinePlayNextBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@dimen/italy_horGuidelinePlayNextBottom" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_horGuidelineChoiceRow1Top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@dimen/italy_horGuidelineChoiceRow1Top" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_horGuidelineChoiceRow1Middle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@dimen/italy_horGuidelineChoiceRow1Middle" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_horGuidelineChoiceRow1Bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="@dimen/italy_horGuidelineChoiceRow1Bottom" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/italy_horGuidelineChoiceRow2Top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
