        android:id="@+id/verGuidelineOptionsLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/verGuidelineOptionsLeft" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verGuidelineOptionsRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="@dimen/verGuidelineOptionsRight" />

    <!-- Views -->
    <TextView
        android:id="@+id/gameNumberView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#9C27B0"
        android:gravity="center"
        android:tag="1"
        android:text="0"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineStatusBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineGameNoCLBorder"
        app:layout_constraintStart_toStartOf="@id/verGuidelineGameNoLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineStatusTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="100sp"
        app:autoSizeStepGranularity="2sp"
        android:padding="0dp"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/challengeLevelView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFD700"
        android:gravity="center"
        android:tag="1"
        android:text="0"
        android:textStyle="bold"
        android:textColor="#000000"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineStatusBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineCLStageBorder"
        app:layout_constraintStart_toStartOf="@id/verGuidelineGameNoCLBorder"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineStatusTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="100sp"
        app:autoSizeStepGranularity="2sp"
        android:padding="0dp"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/stageLevelView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#000000"
        android:gravity="center"
        android:tag="1"
        android:text="0"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineStatusBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineStageBarsBorder"
        app:layout_constraintStart_toStartOf="@id/verGuidelineCLStageBorder"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineStatusTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="100sp"
        app:autoSizeStepGranularity="2sp"
        android:padding="0dp"
        android:maxLines="1"/>

    <ProgressBar
        android:id="@+id/accuracyBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:progressBackgroundTint="@android:color/transparent"
        android:progress="0"
        android:max="100"
        android:scaleY="5.25"
        android:indeterminate="false"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineStatusMiddle"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineBarsPointsBorder"
        app:layout_constraintStart_toStartOf="@id/verGuidelineStageBarsBorder"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineStatusTop" />

    <ProgressBar
        android:id="@+id/attemptsBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:progressBackgroundTint="@android:color/transparent"
        android:progress="0"
        android:max="100"
        android:scaleY="2.25"
        android:indeterminate="false"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineStatusBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineBarsPointsBorder"
        app:layout_constraintStart_toStartOf="@id/verGuidelineStageBarsBorder"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineStatusMiddle" />

    <TextView
        android:id="@+id/pointsTextView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#9C27B0"
        android:gravity="center"
        android:tag="1"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:text="@string/pointsScored"
        android:progress="0"
        android:max="100"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineStatusBottom"
        app:layout_constraintEnd_toEndOf="@id/verGuidelinePointsRight"
        app:layout_constraintStart_toStartOf="@id/verGuidelineBarsPointsBorder"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineStatusTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="100sp"
        app:autoSizeStepGranularity="2sp"
        android:padding="0dp"
        android:maxLines="1"/>

    <ImageView
        android:id="@+id/referenceItem"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onRefClick"
        android:padding="2dp"
        android:tag="0"
        app:layout_constraintBottom_toTopOf="@+id/italy_horGuidelineRefBottom"
        app:layout_constraintStart_toStartOf="@+id/italy_verGuidelineRefLeft"
        app:layout_constraintEnd_toEndOf="@+id/italy_verGuidelineRefRight"
        app:layout_constraintTop_toTopOf="@+id/italy_horGuidelineRefTop"
        app:srcCompat="@drawable/zz_click_for_word_audio"/>

    <ImageView
        android:id="@+id/playNextWord"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="getAnotherWord"
        android:padding="2dp"
        android:tag="0"
        app:layout_constraintBottom_toTopOf="@+id/italy_horGuidelinePlayNextBottom"
        app:layout_constraintStart_toStartOf="@+id/italy_verGuidelinePlayNextLeft"
        app:layout_constraintEnd_toEndOf="@+id/italy_verGuidelinePlayNextRight"
        app:layout_constraintTop_toTopOf="@+id/italy_horGuidelinePlayNextTop"
        app:srcCompat="@drawable/zz_forward_green"/>

    <ImageView
        android:id="@+id/wordImage01"
        android:tag="1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/wordImage01"
        android:onClick="onSelection"
        android:rotationY="0"
        android:translationZ="90dp"
        app:layout_constraintBottom_toTopOf="@+id/italy_horGuidelineChoiceRow1Middle"
        app:layout_constraintEnd_toEndOf="@+id/italy_verGuidelineChoiceCol1Right"
        app:layout_constraintStart_toStartOf="@+id/italy_verGuidelineChoiceCol1Left"
        app:layout_constraintTop_toTopOf="@+id/italy_horGuidelineChoiceRow1Top"
        android:padding="4dp"
        app:srcCompat="@drawable/zz_sil" />

    <ImageView
        android:id="@+id/wordImage02"
        android:tag="2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/wordImage02"
        android:onClick="onSelection"
        android:rotationY="0"
        android:translationZ="90dp"
        app:layout_constraintBottom_toTopOf="@+id/italy_horGuidelineChoiceRow1Middle"
        app:layout_constraintEnd_toEndOf="@+id/italy_verGuidelineChoiceCol2Right"
        app:layout_constraintStart_toStartOf="@+id/italy_verGuidelineChoiceCol2Left"
        app:layout_constraintTop_toTopOf="@+id/italy_horGuidelineChoiceRow1Top"
        android:padding="4dp"
        app:srcCompat="@drawable/zz_sil" />

    <ImageView
        android:id="@+id/wordImage03"
        android:tag="3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/wordImage03"
        android:onClick="onSelection"
        android:rotationY="0"
        android:translationZ="90dp"
        app:layout_constraintBottom_toTopOf="@+id/italy_horGuidelineChoiceRow1Middle"
        app:layout_constraintEnd_toEndOf="@+id/italy_verGuidelineChoiceCol3Right"
        app:layout_constraintStart_toStartOf="@+id/italy_verGuidelineChoiceCol3Left"
        app:layout_constraintTop_toTopOf="@+id/italy_horGuidelineChoiceRow1Top"
        android:padding="4dp"
        app:srcCompat="@drawable/zz_sil" />

    <ImageView
        android:id="@+id/wordImage04"
        android:tag="4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/wordImage04"
        android:onClick="onSelection"
        android:rotationY="0"
        android:translationZ="90dp"
        app:layout_constraintBottom_toTopOf="@+id/italy_horGuidelineChoiceRow1Middle"
        app:layout_constraintEnd_toEndOf="@+id/italy_verGuidelineChoiceCol4Right"
        app:layout_constraintStart_toStartOf="@+id/italy_verGuidelineChoiceCol4Left"
        app:layout_constraintTop_toTopOf="@+id/italy_horGuidelineChoiceRow1Top"
        android:padding="4dp"
        app:srcCompat="@drawable/zz_sil" />

    <ImageView
        android:id="@+id/wordImage05"
        android:tag="5"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/wordImage05"
        android:onClick="onSelection"
        android:rotationY="0"
        android:translationZ="90dp"
        app:layout_constraintBottom_toTopOf="@+id/italy_horGuidelineChoiceRow2Middle"
        app:layout_constraintEnd_toEndOf="@+id/italy_verGuidelineChoiceCol1Right"
        app:layout_constraintStart_toStartOf="@+id/italy_verGuidelineChoiceCol1Left"
        app:layout_constraintTop_toTopOf="@+id/italy_horGuidelineChoiceRow2Top"
        android:padding="4dp"
        app:srcCompat="@drawable/zz_sil" />

    <ImageView
        android:id="@+id/wordImage06"
        android:tag="6"
        android:layout_width="0dp"
