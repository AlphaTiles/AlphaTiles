<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aboutCL"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".About">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineLogoBottom"
        app:layout_constraintEnd_toEndOf="@id/verGuidelineMainRight"
        app:layout_constraintStart_toStartOf="@id/verGuidelineMainLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineLogoTop"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/zz_alphatileslogoandtext"
        android:contentDescription="@string/alphaTilesLogo" />

    <TextView
        android:id="@+id/gameNameInLOP"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/localAppName"
        android:textColor="#9C27B0"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineGameNameBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineMainMiddleLeft"
        app:layout_constraintStart_toStartOf="@+id/verGuidelineMainLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineGameNameTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeMaxTextSize="26sp"
        app:autoSizeStepGranularity="2sp"
        android:padding = "1dp" />

    <TextView
        android:id="@+id/langNamesPlusCountry"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/langsAndCountry"
        android:textColor="#2196F3"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineLanguagesCountryBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineMainMiddleLeft"
        app:layout_constraintStart_toStartOf="@+id/verGuidelineMainLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineLanguagesCountryTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeStepGranularity="2sp"
        android:padding = "1dp" />

    <TextView
        android:id="@+id/photoAudioCredits"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="1dp"
        android:scrollbars="vertical"
        android:text="@string/audioAndPhoto"
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineCreditsBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineMainRight"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/verGuidelineMainMiddleRight"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineCreditsTop"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/photoAudioCredits2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/audioAndPhoto2"
        android:textColor="#000000"
        android:scrollbars="vertical"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineCreditsBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineMainRight"
        app:layout_constraintStart_toStartOf="@+id/verGuidelineMainMiddleRight"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineCredits2Top"
        android:padding = "1dp" />

    <TextView
        android:id="@+id/email"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/email"
        android:textColor="#000000"
        android:textStyle="bold"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineEmailBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineMainMiddleLeft"
        app:layout_constraintStart_toStartOf="@+id/verGuidelineMainLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineEmailTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeStepGranularity="2sp"
        android:padding = "0dp" />

    <TextView
        android:id="@+id/privacyPolicy"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/privacyPolicy"
        android:textColor="#000000"
        android:textStyle="bold"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelinePrivacyBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineMainMiddleLeft"
        app:layout_constraintStart_toStartOf="@+id/verGuidelineMainLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelinePrivacyTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeStepGranularity="2sp"
        android:padding = "0dp" />

    <TextView
        android:id="@+id/appVersionInEnglish"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/alphaTilesVersionInfo"
        android:textColor="#2196F3"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineVersionBottom"
        app:layout_constraintEnd_toStartOf="@+id/verGuidelineMainMiddleLeft"
        app:layout_constraintStart_toStartOf="@+id/verGuidelineMainLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineVersionTop"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeStepGranularity="2sp"
        android:padding = "0dp" />

    <ImageView
        android:id="@+id/gamesHomeImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="goBackToEarth"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintEnd_toStartOf="@+id/bottomMiddleSpacer"
        app:layout_constraintStart_toStartOf="@id/verGuidelineMainLeft"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        android:contentDescription="@string/playerAvatar"
        app:srcCompat="@drawable/zz_games_home" />

    <TextView
        android:id="@+id/bottomMiddleSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:tag="BMS"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintEnd_toStartOf="@+id/logoSILImage"
        app:layout_constraintStart_toEndOf="@+id/gamesHomeImage"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"/>

    <ImageView
        android:id="@+id/instructions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/playAudioInstructions"
        android:onClick="playAudioInstructionsAbout"
        android:rotationY="0"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintEnd_toEndOf="@+id/bottomMiddleSpacer"
        app:layout_constraintStart_toStartOf="@+id/bottomMiddleSpacer"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        app:srcCompat="@drawable/zz_instructions" />

    <ImageView
        android:id="@+id/logoSILImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintEnd_toEndOf="@id/verGuidelineMainRight"
        app:layout_constraintStart_toEndOf="@+id/bottomMiddleSpacer"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        android:contentDescription="@string/playerAvatar"
        app:srcCompat="@drawable/zz_sil" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineLogoTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.01" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineLogoBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.16" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineGameNameTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.17" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineGameNameBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.26" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineLanguagesCountryTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.27" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineLanguagesCountryBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.34" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineCreditsTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.35" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineCreditsBottomIfLang2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineCredits2Top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.53" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineCreditsBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.70" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineEmailTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.71" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineEmailBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.77" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelinePrivacyTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.78" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelinePrivacyBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.84" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineVersionTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineVersionBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.91" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineOptionsTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.93" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horGuidelineOptionsBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.99" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verGuidelineMainLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.01" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verGuidelineMainMiddleLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.99" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verGuidelineMainMiddleRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.01" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/verGuidelineMainRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.99" />

</androidx.constraintlayout.widget.ConstraintLayout>