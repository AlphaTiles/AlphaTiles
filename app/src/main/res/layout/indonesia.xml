<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/indonesiaCL"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".Indonesia">

    <!-- ═══════════════════════════════════════════════════════
         WORD BAND 1   guidelineH1 (0.08) → guidelineH2 (0.18)
         Image: left 20% of screen  |  Word text: right 80%
    ═══════════════════════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/wordImage01"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="2dp"
        android:onClick="clickPicHearAudio"
        android:tag="1"
        android:scaleType="fitCenter"
        android:contentDescription="@string/activeWordPicture"
        app:srcCompat="@drawable/zz_alphatileslogo"
        app:layout_constraintTop_toTopOf="@+id/guidelineH1"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineVImg" />

    <TextView
        android:id="@+id/word01"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onWordTextClick"
        android:tag="1"
        android:background="#4CAF50"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="2dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="60sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="@+id/guidelineH1"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH2"
        app:layout_constraintStart_toEndOf="@+id/guidelineVImg"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/wordChoice01"/>

    <!-- TILE BAND 1   guidelineH2 (0.18) → guidelineH3 (0.28) -->
    <LinearLayout
        android:id="@+id/tileBand1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        app:layout_constraintTop_toTopOf="@+id/guidelineH2.5"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════
         WORD BAND 2   guidelineH4 (0.29) → guidelineH5 (0.39)
    ═══════════════════════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/wordImage02"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="2dp"
        android:onClick="clickPicHearAudio"
        android:tag="2"
        android:scaleType="fitCenter"
        android:contentDescription="@string/activeWordPicture"
        app:srcCompat="@drawable/zz_alphatileslogo"
        app:layout_constraintTop_toTopOf="@+id/guidelineH4"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineVImg" />

    <TextView
        android:id="@+id/word02"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onWordTextClick"
        android:tag="2"
        android:background="#4CAF50"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="2dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="60sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="@+id/guidelineH4"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH5"
        app:layout_constraintStart_toEndOf="@+id/guidelineVImg"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/wordChoice02" />

    <!-- TILE BAND 2   guidelineH5 (0.39) → guidelineH6 (0.49) -->
    <LinearLayout
        android:id="@+id/tileBand2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        app:layout_constraintTop_toTopOf="@+id/guidelineH5.5"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH6"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════
         WORD BAND 3   guidelineH7 (0.50) → guidelineH8 (0.60)
    ═══════════════════════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/wordImage03"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="2dp"
        android:onClick="clickPicHearAudio"
        android:tag="3"
        android:scaleType="fitCenter"
        android:contentDescription="@string/activeWordPicture"
        app:srcCompat="@drawable/zz_alphatileslogo"
        app:layout_constraintTop_toTopOf="@+id/guidelineH7"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH7.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineVImg" />

    <TextView
        android:id="@+id/word03"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onWordTextClick"
        android:tag="3"
        android:background="#4CAF50"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="2dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="60sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="@+id/guidelineH7"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH7.5"
        app:layout_constraintStart_toEndOf="@+id/guidelineVImg"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/wordChoice03" />

    <!-- TILE BAND 3   guidelineH8 (0.60) → guidelineH9 (0.70) -->
    <LinearLayout
        android:id="@+id/tileBand3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        app:layout_constraintTop_toTopOf="@+id/guidelineH8"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════
         WORD BAND 4   guidelineH10 (0.71) → guidelineH11 (0.81)
    ═══════════════════════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/wordImage04"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="2dp"
        android:onClick="clickPicHearAudio"
        android:tag="4"
        android:scaleType="fitCenter"
        android:contentDescription="@string/activeWordPicture"
        app:srcCompat="@drawable/zz_alphatileslogo"
        app:layout_constraintTop_toTopOf="@+id/guidelineH10"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH10.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guidelineVImg" />

    <TextView
        android:id="@+id/word04"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="onWordTextClick"
        android:tag="4"
        android:background="#4CAF50"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="2dp"
        android:maxLines="1"
        android:importantForAccessibility="no"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="5sp"
        app:autoSizeMaxTextSize="60sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toTopOf="@+id/guidelineH10"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH10.5"
        app:layout_constraintStart_toEndOf="@+id/guidelineVImg"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/wordChoice04" />

    <!-- TILE BAND 4   guidelineH11 (0.81) → guidelineHSys1 (0.91) -->
    <LinearLayout
        android:id="@+id/tileBand4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:background="#EEEEEE"
        app:layout_constraintTop_toTopOf="@+id/guidelineH11"
        app:layout_constraintBottom_toTopOf="@+id/guidelineH12"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════
         BOTTOM BAR   guidelineHSys1 (0.91) → guidelineHSys2 (0.99)

         LTR slot order (mirrors Malaysia's RTL-fix chain):
           backwardArrow | gamesHome | bottomMiddleSpacer(+instructions) | forwardArrow

         repeatImage is GONE — it must exist because GameActivity.
         setOptionsRowUnclickable() calls repeatImage.setClickable()
         for every country that isn't Romania, Sudan, or Malaysia.
         Without this view the call NPEs and crashes the app on launch.
    ═══════════════════════════════════════════════════════════ -->

    <ImageView
        android:id="@+id/repeatImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:contentDescription="@string/playAgain"
        app:srcCompat="@drawable/zz_forward_inactive"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/backwardArrowImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="prevPageArrow"
        android:visibility="invisible"
        android:contentDescription="@string/playAgain"
        app:srcCompat="@drawable/zz_backward_inactive"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintStart_toStartOf="@id/guidelineV1"
        app:layout_constraintEnd_toStartOf="@+id/gamesHomeImage" />

    <ImageView
        android:id="@+id/gamesHomeImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="goBackToEarth"
        android:contentDescription="@string/playerAvatar"
        app:srcCompat="@drawable/zz_games_home"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintStart_toEndOf="@+id/backwardArrowImage"
        app:layout_constraintEnd_toStartOf="@+id/bottomMiddleSpacer" />

    <TextView
        android:id="@+id/bottomMiddleSpacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:tag="BMS"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintStart_toEndOf="@+id/gamesHomeImage"
        app:layout_constraintEnd_toStartOf="@+id/forwardArrowImage" />

    <ImageView
        android:id="@+id/instructions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="playAudioInstructions"
        android:contentDescription="@string/playAudioInstructions"
        android:rotationY="0"
        app:srcCompat="@drawable/zz_instructions"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintStart_toStartOf="@+id/bottomMiddleSpacer"
        app:layout_constraintEnd_toEndOf="@+id/bottomMiddleSpacer" />

    <ImageView
        android:id="@+id/forwardArrowImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:onClick="nextPageArrow"
        android:visibility="invisible"
        android:contentDescription="@string/playAgain"
        app:srcCompat="@drawable/zz_forward_inactive"
        app:layout_constraintTop_toTopOf="@+id/horGuidelineOptionsTop"
        app:layout_constraintBottom_toTopOf="@+id/horGuidelineOptionsBottom"
        app:layout_constraintStart_toEndOf="@+id/bottomMiddleSpacer"
        app:layout_constraintEnd_toEndOf="@id/guidelineV2" />

    <!-- ═══════════════════════════════════════════════════════
         GUIDELINES
    ═══════════════════════════════════════════════════════════ -->

    <!-- wordBand1 top -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH1"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.01" />

    <!-- wordBand1 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH2"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.11" />

    <!-- tileBand1 top -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH2.5"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.12" />

    <!-- tileBand1 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH3"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.22" />

    <!-- wordBand2 top  -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH4"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.24" />

    <!-- wordBand2 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH5"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.34" />

    <!-- tileBand2 top -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH5.5"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.35" />

    <!-- tileBand2 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH6"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.45" />

    <!-- wordBand3 top -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH7"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.47" />

    <!-- wordBand3 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH7.5"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.57" />

    <!-- tileBand3 top -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH8"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.58" />

    <!-- tileBand3 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH9"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.68" />

    <!-- wordBand4 top -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH10"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.70" />

    <!-- wordBand4 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH10.5"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.80" />

    <!-- tileBand4 top -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH11"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.81" />

    <!-- tileBand4 bottom -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineH12"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.91" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/horGuidelineOptionsTop"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.93" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/horGuidelineOptionsBottom"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" app:layout_constraintGuide_percent="0.99" />

    <!-- Vertical — side margins (1% each, matching Peru) -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineV1"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.01" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/verGuidelineOptionsLeft"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.01" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/verGuidelineOptionsRight"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.99" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineV1.1"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.12" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineV1.2"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.18" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineV1.3"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.24" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineV1.4"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.88" />

    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineV2"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.99" />

    <!-- Vertical — image / word-text divider at 20% of screen width -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/guidelineVImg"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="vertical" app:layout_constraintGuide_percent="0.20" />

</androidx.constraintlayout.widget.ConstraintLayout>
